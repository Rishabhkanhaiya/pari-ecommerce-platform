# =============================================
# PARI GIFT CENTER - Environment Variables
# =============================================
# Copy this file to .env.local and fill in your values

# --- SUPABASE ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- RAZORPAY ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-key

# --- WHATSAPP (WATI or Twilio) ---
WHATSAPP_API_URL=https://live-mt-server.wati.io/api/v1
WHATSAPP_ACCESS_TOKEN=your-wati-access-token
WHATSAPP_SHOP_NUMBER=91XXXXXXXXXX

# --- TWILIO (for OTP SMS via Supabase Auth) ---
# Configure directly in Supabase Dashboard → Auth → SMS Provider

# --- APP ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SHOP_NAME=Pari Gift Center
NEXT_PUBLIC_SHOP_PHONE=+91XXXXXXXXXX
NEXT_PUBLIC_FREE_DELIVERY_ABOVE=299
NEXT_PUBLIC_DELIVERY_START_HOUR=10
NEXT_PUBLIC_DELIVERY_END_HOUR=20

# --- ADMIN ---
ADMIN_EMAIL=admin@parigiftcenter.com
ADMIN_SECRET=your-strong-admin-secret-key
